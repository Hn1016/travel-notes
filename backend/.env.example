# Copy to backend/.env and fill in. The app works without it; only the
# "Look up" button for flight numbers needs a key.
# Get a key: subscribe to AeroDataBox on RapidAPI (free tier available).
AERODATABOX_API_KEY=

# Optional: better hotel search (finds newer hotels). Without it, OpenStreetMap is used.
# Google Cloud console -> enable "Places API (New)" -> create an API key.
GOOGLE_PLACES_API_KEY=
